{
  "hosting": {
    "site": "moneypot",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.git/**",
      "**/.playwright-mcp/**",
      "README.md",
      "LICENSE"
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          { "key": "Content-Type", "value": "application/json" }
        ]
      }
    ],
    "rewrites": [
      { "source": "/moneypot/**", "destination": "/index.html" }
    ],
    "cleanUrls": true
  }
}
